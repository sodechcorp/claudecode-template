{
  "language": "japanese",
  "env": {
    "_comment_PYTHONIOENCODING": "Windows の Python はデフォルト stdout が cp932。Claude Code は UTF-8 期待のため、print('小俣') 等が化ける。全 Python 実行を UTF-8 stdout に統一する。",
    "PYTHONIOENCODING": "utf-8"
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\":\"[COMPACT] /backlog の途中で圧縮した場合は、再開時に /backlog {課題ID}（対応中の課題ID）を打ち直してください。Phase 0d が investigation.md のフロントマターからコンテキストを復元します。（要約への指示）docs/knowledge/pitfalls.md・docs/decisions.md へまだ記録していない知見・方針判断は、その記録を Pending Tasks に残すこと。/backlog を実行していた場合だけ、課題IDと進行中の Phase も残すこと。どちらも該当が無ければ何も書かないこと。\"}'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|mcp__backlog__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-operation.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-query-reminder.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(python scripts/python/git-sync/git-sync-merge.py --branch *)",
      "mcp__backlog__*"
    ],
    "deny": [
      "Bash(sf project deploy* --target-org*prod*)",
      "Bash(sf project deploy* --targetusername*prod*)",
      "Bash(sf project deploy* -o*prod*)",
      "Bash(sf project deploy* -u*prod*)",
      "Bash(sf metadata deploy* --target-org*prod*)",
      "Bash(sf metadata deploy* --targetusername*prod*)",
      "Bash(sf metadata deploy* -o*prod*)",
      "Bash(sf metadata deploy* -u*prod*)",
      "Bash(sf data upsert* --target-org*prod*)",
      "Bash(sf data upsert* --targetusername*prod*)",
      "Bash(sf data upsert* -o*prod*)",
      "Bash(sf data upsert* -u*prod*)",
      "Bash(sf data delete* --target-org*prod*)",
      "Bash(sf data delete* --targetusername*prod*)",
      "Bash(sf data delete* -o*prod*)",
      "Bash(sf data delete* -u*prod*)",
      "Bash(sf data update* --target-org*prod*)",
      "Bash(sf data update* --targetusername*prod*)",
      "Bash(sf data update* -o*prod*)",
      "Bash(sf data update* -u*prod*)",
      "Bash(sf data create* --target-org*prod*)",
      "Bash(sf data create* --targetusername*prod*)",
      "Bash(sf data create* -o*prod*)",
      "Bash(sf data create* -u*prod*)",
      "Bash(sf data import* --target-org*prod*)",
      "Bash(sf data import* --targetusername*prod*)",
      "Bash(sf data import* -o*prod*)",
      "Bash(sf data import* -u*prod*)",
      "Bash(sf data bulk* --target-org*prod*)",
      "Bash(sf data bulk* --targetusername*prod*)",
      "Bash(sf data bulk* -o*prod*)",
      "Bash(sf data bulk* -u*prod*)",
      "Bash(sf data resume* --target-org*prod*)",
      "Bash(sf data resume* --targetusername*prod*)",
      "Bash(sf data resume* -o*prod*)",
      "Bash(sf data resume* -u*prod*)",
      "Bash(sf apex run* --target-org*prod*)",
      "Bash(sf apex run* --targetusername*prod*)",
      "Bash(sf apex run* -o*prod*)",
      "Bash(sf apex run* -u*prod*)",
      "Bash(sf package install* --target-org*prod*)",
      "Bash(sf package install* --targetusername*prod*)",
      "Bash(sf package install* -o*prod*)",
      "Bash(sf package install* -u*prod*)",
      "Bash(sf package uninstall* --target-org*prod*)",
      "Bash(sf package uninstall* --targetusername*prod*)",
      "Bash(sf package uninstall* -o*prod*)",
      "Bash(sf package uninstall* -u*prod*)",
      "Bash(sf org delete* --target-org*prod*)",
      "Bash(sf org delete* --targetusername*prod*)",
      "Bash(sf org delete* -o*prod*)",
      "Bash(sf org delete* -u*prod*)",
      "Bash(sf org assign* --target-org*prod*)",
      "Bash(sf org assign* --targetusername*prod*)",
      "Bash(sf org assign* -o*prod*)",
      "Bash(sf org assign* -u*prod*)",
